#!/bin/bash
# Run `crocodash process` (the forcing extraction) for one Alaska case.
#
# Split out from `crocodash create --configure-only` because this is the long
# pole: it fetches GLORYS from the NCAR RDA and regrids initial and boundary
# conditions for every open segment, so it wants a real walltime allowance
# rather than sharing one with case construction.
#
# Submit with:
#   qsub -v CASEROOT=/glade/u/home/manishrv/croc_cases/alaska_small \
#        -N pr_small submit_process.pbs
#
#PBS -A ncgd0011
# develop (routes to cpudev), not main: forcing extraction is serial Python, so
# a whole-node main request bought nothing and sat queued while develop jobs
# turned around in seconds. cpudev refuses walltime beyond 3h -- a direct
# `-q cpudev` submission is denied outright -- so ask develop for 3h, which is
# what the case-creation jobs used successfully.
#PBS -q develop
#PBS -l walltime=03:00:00
#PBS -l select=1:ncpus=16:mem=200GB
#PBS -j oe
#PBS -o /glade/derecho/scratch/manishrv/crocodash_logs/

set -euo pipefail
source /glade/u/apps/opt/miniforge/25.11/etc/profile.d/conda.sh
conda activate CrocoDash

echo "host       : $(hostname)"
echo "ESMFMKFILE : ${ESMFMKFILE:-<unset>}"
echo "caseroot   : ${CASEROOT:?CASEROOT must be passed via qsub -v CASEROOT=...}"
echo "started    : $(date)"
echo

crocodash process --caseroot "$CASEROOT" --all

echo
echo "finished   : $(date)"
